{
    "name": "dealnews/aws-ses",
    "description": "A fluent wrapper for AWS SES email sending",
    "type": "library",
    "license": "BSD-3-Clause",
    "config": {
        "optimize-autoloader": true,
        "discard-changes": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "DealNews\\AwsSes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DealNews\\AwsSes\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "aws/aws-sdk-php": "^3.300"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpunit/phpunit": "^11.3"
    },
    "scripts": {
        "test": [
            "@lint",
            "phpunit --colors=never --coverage-text"
        ],
        "lint": [
            "parallel-lint src/ tests/"
        ],
        "fix": [
            "php-cs-fixer fix --config .php-cs-fixer.dist.php src tests"
        ]
    }
}
